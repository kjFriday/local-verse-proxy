# Copy to seats.env and fill in. seats.env is gitignored.
#   cp seats.env.example seats.env && chmod 600 seats.env

# --- The lock -------------------------------------------------------
# Admin key for the proxy. Must start with sk-. Left empty on purpose:
# the proxy will not start until you set it. Generate one with:
#   echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Encrypts stored credentials in the database. Set once, never change
# it, or stored values can't be decrypted. Generate it the same way.
LITELLM_SALT_KEY=sk-change-me

# --- Storage --------------------------------------------------------
# The password must match in both lines. Letters and digits only
# (openssl rand -hex 16). Set it before the first `docker compose up`;
# changing it later means `docker compose down -v`, which deletes all
# keys.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://litellm:change-me@db:5432/litellm

# --- Upstreams (only the proxy machine holds these) -----------------
OLLAMA_API_BASE=http://192.168.1.50:11434
ANTHROPIC_API_KEY=

# --- Mint script defaults -------------------------------------------
PROXY_URL=http://localhost:4000
DEFAULT_MODELS=local
DEFAULT_BUDGET=5
DEFAULT_DURATION=30d
